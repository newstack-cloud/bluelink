# Test cleanup of specific resource types, then of all of them.
# The engine refuses a cleanup of a category another cleanup is still running, so both
# cases live in one script: the scripts in a directory run in parallel.
wait_engine

exec bluelink cleanup --validations --changesets --connect-protocol=tcp --engine-endpoint=$BLUELINK_ENGINE_ENDPOINT --engine-auth-config-file=engine.auth.json
stdout 'Cleanup complete'
stdout 'validations'
stdout 'changesets'

# When no flags are provided and running in headless mode, all resource types
# are cleaned up by default.
exec bluelink cleanup --connect-protocol=tcp --engine-endpoint=$BLUELINK_ENGINE_ENDPOINT --engine-auth-config-file=engine.auth.json
stdout 'Cleanup complete'
stdout 'validations'
stdout 'changesets'
stdout 'reconciliation results'
stdout 'events'

-- bluelink.config.toml --
# Empty config file

-- engine.auth.json --
{
  "method": "apiKey",
  "apiKey": "test-api-key"
}
